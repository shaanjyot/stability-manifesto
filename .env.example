# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use either legacy anon key or newer publishable key from Dashboard → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: Database + Storage writes from API routes (never NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# Admin sign-in uses Supabase Auth (email + password). Only these emails may use /admin after login.
# Comma-separated, case-insensitive. (Alias: SUPABASE_ADMIN_EMAIL)
ADMIN_EMAIL=you@example.com
